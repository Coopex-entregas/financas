# ---------------------------------------------------------------------------
# Cache curto para o HTML pesado do admin + invalidação em qualquer alteração
# ---------------------------------------------------------------------------

_admin_cache: dict[tuple, tuple[float, bytes, list[tuple[str, str]], int]] = {}
_admin_cache_lock = threading.RLock()
_admin_cache_version = 0
_original_admin_dashboard = app.view_functions.get("admin_dashboard")


def _invalidate_admin_cache() -> None:
    global _admin_cache_version
    with _admin_cache_lock:
        _admin_cache_version += 1
        _admin_cache.clear()


@app.before_request
def _invalidate_cache_on_write():
    if request.method not in {"GET", "HEAD", "OPTIONS"}:
        _invalidate_admin_cache()
    elif any(token in request.path.lower() for token in ("/delete", "/excluir", "/purge")):
        _invalidate_admin_cache()


if _original_admin_dashboard:
    def _cached_admin_dashboard(*args, **kwargs):
        if request.method != "GET" or session.get("user_tipo") != "admin":
            return _original_admin_dashboard(*args, **kwargs)
        key = (
            session.get("user_id"),
            request.query_string,
            _admin_cache_version,
        )
        now = time.monotonic()
        with _admin_cache_lock:
            cached = _admin_cache.get(key)
            if cached and now - cached[0] <= 12:
                response = Response(cached[1], status=cached[3])
                for name, value in cached[2]:
                    response.headers[name] = value
                response.headers["X-COOPEX-Cache"] = "HIT"
                return response
        response = make_response(_original_admin_dashboard(*args, **kwargs))
        if response.status_code == 200 and response.mimetype == "text/html" and "Set-Cookie" not in response.headers:
            headers = [(k, v) for k, v in response.headers.items() if k.lower() not in {"content-length", "content-encoding"}]
            with _admin_cache_lock:
                _admin_cache[key] = (now, response.get_data(), headers, response.status_code)
        response.headers["X-COOPEX-Cache"] = "MISS"
        return response

    _cached_admin_dashboard.__name__ = "admin_dashboard"
    app.view_functions["admin_dashboard"] = _cached_admin_dashboard


