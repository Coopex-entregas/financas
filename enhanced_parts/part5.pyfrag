_FAST_SCRIPT = """
<script id="coopexFastScript">
(function(){
  const path=location.pathname;
  if(path.startsWith('/admin')) document.body.classList.add('coopex-admin-fast');
  document.querySelectorAll('form[method="get"],form[method="GET"]').forEach(form=>{
    let timer;
    form.querySelectorAll('select,input[type="date"],input[type="month"]').forEach(el=>{
      el.addEventListener('change',()=>{clearTimeout(timer);timer=setTimeout(()=>form.requestSubmit(),180)});
    });
  });
  const toast=document.createElement('div');toast.className='coopex-fast-toast';document.body.appendChild(toast);
  window.coopexToast=(msg)=>{toast.textContent=msg;toast.style.display='block';setTimeout(()=>toast.style.display='none',1800)};
})();
</script>
"""


def _inject_enhancements(html: str) -> str:
    endpoint = request.endpoint or ""
    path = request.path
    additions = _INJECT_STYLE + _FAST_SCRIPT
    if path.startswith("/admin"):
        html = html.replace("<body", "<body class=\"coopex-admin-fast\"", 1) if "<body" in html and "coopex-admin-fast" not in html else html
        html = html.replace("<body class=\"coopex-admin-fast\">", "<body class=\"coopex-admin-fast\">" + _ADMIN_NAV, 1)
        if _ADMIN_NAV not in html and "<body" in html:
            end = html.find(">", html.find("<body"))
            html = html[: end + 1] + _ADMIN_NAV + html[end + 1 :]
    elif endpoint == "portal_cooperado" or path in {"/portal/cooperado", "/painel/cooperado"}:
        additions += '<a class="coopex-production-fab" href="/coop/producoes/nova">Informar produção</a>'
    elif endpoint == "portal_restaurante" or path == "/portal/restaurante":
        additions += '<a id="coopexPendingLink" class="coopex-pending-link" href="/rest/producoes/pendentes">Produções pendentes <b id="coopexPendingCount"></b></a>'
        additions += """<script>(function(){const n=document.getElementById('coopexPendingCount');fetch('/api/rest/producoes/pendentes/status',{cache:'no-store'}).then(r=>r.json()).then(x=>{if(n)n.textContent=x.count?'('+x.count+')':''}).catch(()=>{});})();</script>"""
    return html.replace("</body>", additions + "</body>", 1) if "</body>" in html else html + additions


@app.after_request
def _fast_response(response):
    try:
        if response.status_code == 200 and response.mimetype == "text/html" and not response.is_streamed:
            html = response.get_data(as_text=True)
            response.set_data(_inject_enhancements(html))
        if request.path.startswith("/static/"):
            response.headers["Cache-Control"] = "public, max-age=604800, immutable"
        elif response.mimetype in {"text/html", "application/json"}:
            response.headers.setdefault("Cache-Control", "no-cache")

        accepts = request.headers.get("Accept-Encoding", "")
        content_type = response.content_type or ""
        compressible = any(x in content_type for x in ("text/", "json", "javascript", "xml"))
        if (
            "gzip" in accepts.lower()
            and compressible
            and not response.is_streamed
            and not response.headers.get("Content-Encoding")
            and 200 <= response.status_code < 300
        ):
            data = response.get_data()
            if len(data) >= 1200:
                compressed = gzip.compress(data, compresslevel=5)
                if len(compressed) < len(data):
                    response.set_data(compressed)
                    response.headers["Content-Encoding"] = "gzip"
                    response.headers["Content-Length"] = str(len(compressed))
                    response.headers["Vary"] = "Accept-Encoding"
        if not response.headers.get("ETag") and not response.is_streamed and response.status_code == 200:
            response.set_etag(hashlib.sha1(response.get_data()).hexdigest())
    except Exception:
        app.logger.exception("Falha na otimização da resposta")
    return response


@app.get("/healthz/enhanced", endpoint="enhanced_health")
def enhanced_health():
    return jsonify(ok=True, layer="enhanced", pending_table=True)
